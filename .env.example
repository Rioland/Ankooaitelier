# Neon (added automatically when you connect Neon from the Vercel Storage tab)
DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require"

# Vercel Blob (added automatically when you create a Blob store in Vercel Storage)
BLOB_READ_WRITE_TOKEN=""

# Admin login
ADMIN_EMAIL="admin@ankoo.ng"
ADMIN_PASSWORD="change-me-please"
# Long random string used to sign admin sessions (e.g. `openssl rand -base64 32`)
AUTH_SECRET="replace-with-a-long-random-string"

# Public site URL (used for WhatsApp order links)
NEXT_PUBLIC_SITE_URL="https://ankoo.vercel.app"
